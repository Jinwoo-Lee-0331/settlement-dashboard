# Neon(또는 다른 Postgres) 연결 문자열. 설정하지 않으면 로컬 settlement.db(SQLite)를 사용합니다.
# 이 파일을 복사해 .env로 저장하고 실제 값을 채워 넣으세요 (.env는 git에 올라가지 않습니다).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# 정산 엑셀 기본 비밀번호 (업로드 폼에 자동으로 채워짐) - 설정 안 하면 빈 칸으로 시작
COUPANG_EXCEL_PASSWORD=
BAEMIN_EXCEL_PASSWORD=
